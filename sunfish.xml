<?xml version="1.0" encoding="UTF-8"?>
<manifest>
    <!--
    * target: Google sunfish(Pixel4a)
    * rom: AOSP
    -->
  <remote  name="aosp"
           fetch="https://android.googlesource.com"
           review="https://android-review.googlesource.com/" />

  <!-- Inline kernel build -->
  <project path="prebuilts/kernel-build-tools" name="kernel/prebuilts/build-tools" clone-depth="1" remote="aosp" revision="refs/tags/android-14.0.0_r0.17" />

  <remote  name="lineage"
           fetch="https://github.com/LineageOS"
           revision="refs/heads/lineage-21.0" />

  <!-- Inline kernel build -->
  <project path="prebuilts/clang/kernel/linux-x86/clang-r416183b" name="android_prebuilts_clang_kernel_linux-x86_clang-r416183b" clone-depth="1" remote="lineage"  revision="lineage-20.0" />
  <project path="prebuilts/gcc/linux-x86/aarch64/aarch64-linux-android-4.9" name="android_prebuilts_gcc_linux-x86_aarch64_aarch64-linux-android-4.9" groups="pdk,linux,arm" clone-depth="1" revision="lineage-19.1" remote="lineage" />
  <project path="prebuilts/gcc/linux-x86/arm/arm-linux-androideabi-4.9" name="android_prebuilts_gcc_linux-x86_arm_arm-linux-androideabi-4.9" groups="pdk,linux,arm" clone-depth="1" revision="lineage-19.1" remote="lineage" />
  <project path="prebuilts/gcc/linux-x86/x86/x86_64-linux-android-4.9" name="android_prebuilts_gcc_linux-x86_x86_x86_64-linux-android-4.9" groups="pdk,linux,x86" clone-depth="1" revision="lineage-19.1" remote="lineage" />

  <!-- Prebuilts -->
  <project path="prebuilts/extract-tools" name="android_prebuilts_extract-tools" remote="lineage" />
  <project path="prebuilts/tools-lineage" name="android_prebuilts_tools-lineage" remote="lineage" />


    <!-- Remote -->
    <remote fetch="https://github.com/tnakamur" name="sunfish" />

    <!-- Device -->
    <remove-project name="device/google/sunfish" />
    <remove-project name="device/google/sunfish-sepolicy" />
    <project name="android_device_google_sunfish" path="device/google/sunfish" remote="sunfish" revision="android-14" />

    <!-- Kernel -->
    <remove-project name="device/google/sunfish-kernel" />
    <project name="android_kernel_google_msm-4.14" path="kernel/google/msm-4.14" remote="sunfish" revision="android-14" />

    <!-- Vendor -->
    <project name="android_vendor_google_sunfish" path="vendor/google/sunfish" remote="sunfish" revision="android-14" />
</manifest>
